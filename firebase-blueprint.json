{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Encrypted user data synchronization document.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "The UID of the user."
        },
        "encryptedPayload": {
          "type": "string",
          "maxLength": 1048576,
          "description": "AES-encrypted JSON payload containing app state."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "ISO timestamp of the last update."
        }
      },
      "required": ["userId", "encryptedPayload", "updatedAt"]
    },
    "VillageSync": {
      "title": "Village Cloud Sync",
      "description": "Shared multi-device family care hub metadata and configuration for Village Mode.",
      "type": "object",
      "properties": {
        "villageToken": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "babyName": {
          "type": "string",
          "maxLength": 80
        },
        "babyDob": {
          "type": "string",
          "maxLength": 32
        },
        "babyAge": {
          "type": "string",
          "maxLength": 40
        },
        "activeBabyId": {
          "type": "string",
          "maxLength": 80
        },
        "babyProfiles": {
          "type": "array",
          "maxItems": 10
        },
        "fluidTarget": {
          "type": "number"
        },
        "allergenMatrix": {
          "type": "array",
          "maxItems": 50
        },
        "vaccineSchedule": {
          "type": "array",
          "maxItems": 80
        },
        "encryptedPayload": {
          "type": "string",
          "maxLength": 1048576
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": ["villageToken", "ownerId", "updatedAt"]
    },
    "VillageMember": {
      "title": "Village Member & Access Role",
      "description": "Authorized member within a baby's village with dynamic role-based access control.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
