        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "uid", "villageToken", "villageOwnerId", "displayName", "accessType", "status", "joinedAt", "updatedAt"]
    },
    "VillageBabyLog": {
      "title": "Synchronized Baby Log Entry",
