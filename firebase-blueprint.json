{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Encrypted user data synchronization document.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "The UID of the user."
        },
        "encryptedPayload": {
          "type": "string",
          "description": "AES-encrypted JSON payload containing app state."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of the last update."
        }
      },
      "required": ["userId", "encryptedPayload", "updatedAt"]
    },
    "MonitorSession": {
      "title": "Monitor Session",
      "description": "WebRTC signaling document for baby monitor.",
      "type": "object",
      "properties": {
        "offer": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "sdp": { "type": "string" }
          }
        },
        "answer": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "sdp": { "type": "string" }
          }
        },
        "updatedAt": {
          "type": "number",
          "description": "Milliseconds timestamp of the last update."
        }
      },
      "required": ["updatedAt"]
    },
    "IceCandidate": {
      "title": "ICE Candidate",
      "description": "WebRTC ICE candidate for P2P connection.",
      "type": "object",
      "properties": {
        "candidate": { "type": "string" },
        "sdpMid": { "type": "string" },
        "sdpMLineIndex": { "type": "number" },
        "usernameFragment": { "type": "string" },
        "from": { 
          "type": "string",
          "enum": ["viewer", "camera"]
        },
        "timestamp": { "type": "number" }
      },
      "required": ["candidate", "from", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user sync document."
    },
    "/monitors/{villageToken}": {
      "schema": "MonitorSession",
      "description": "P2P signaling channel for a village."
    },
    "/monitors/{villageToken}/candidates/{candidateId}": {
      "schema": "IceCandidate",
      "description": "WebRTC candidates for a specific village monitor session."
    }
  }
}
