rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Validation Blueprints

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'encryptedPayload', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'encryptedPayload', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.userId is string
        && data.userId.size() <= 128
        && data.encryptedPayload is string
        && data.encryptedPayload.size() < 1048576
        && data.updatedAt is string
        && data.updatedAt.size() <= 64;
    }

    function isValidVillageSync(data) {
      return data.keys().hasAll(['villageToken', 'ownerId', 'encryptedPayload', 'updatedAt'])
        && data.keys().hasOnly(['villageToken', 'ownerId', 'babyName', 'encryptedPayload', 'updatedBy', 'updatedAt'])
        && isValidId(data.villageToken)
        && data.ownerId is string
        && data.ownerId.size() <= 128
        && data.encryptedPayload is string
        && data.encryptedPayload.size() < 1048576
        && data.updatedAt is string
        && data.updatedAt.size() <= 64
        && (!('babyName' in data) || (data.babyName is string && data.babyName.size() <= 80))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    function isValidMonitor(data) {
      return data.keys().hasAll(['updatedAt'])
        && data.keys().hasOnly(['updatedAt', 'offer', 'answer'])
        && data.updatedAt is number
        && (!('offer' in data) || (data.offer.type is string && data.offer.type.size() <= 32 && data.offer.sdp is string && data.offer.sdp.size() < 16384))
        && (!('answer' in data) || (data.answer.type is string && data.answer.type.size() <= 32 && data.answer.sdp is string && data.answer.sdp.size() < 16384));
    }

    function isValidCandidate(data) {
      return data.keys().hasAll(['candidate', 'from', 'timestamp'])
        && data.keys().hasOnly(['candidate', 'from', 'timestamp', 'sdpMid', 'sdpMLineIndex', 'usernameFragment'])
        && data.candidate is string
        && data.candidate.size() < 4096
        && data.from in ['viewer', 'camera']
        && data.timestamp is number
        && (!('sdpMid' in data) || data.sdpMid == null || (data.sdpMid is string && data.sdpMid.size() <= 128))
        && (!('sdpMLineIndex' in data) || data.sdpMLineIndex == null || data.sdpMLineIndex is number)
        && (!('usernameFragment' in data) || data.usernameFragment == null || (data.usernameFragment is string && data.usernameFragment.size() <= 256));
    }

    function isValidCommunityPost(data) {
      return data.keys().hasAll(['id', 'authorId', 'authorName', 'authorRole', 'category', 'title', 'content', 'upvotes', 'replies', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'authorId', 'authorName', 'authorRole', 'authorLocation', 'babyAgeContext', 'category', 'title', 'content', 'tags', 'upvotes', 'replies', 'isPublic', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorRole is string && data.authorRole.size() <= 80
        && (!('authorLocation' in data) || (data.authorLocation is string && data.authorLocation.size() <= 120))
        && (!('babyAgeContext' in data) || (data.babyAgeContext is string && data.babyAgeContext.size() <= 60))
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 4000
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string)))
        && data.upvotes is list && data.upvotes.size() <= 500 && (data.upvotes.size() == 0 || data.upvotes[0] is string)
        && data.replies is list && data.replies.size() <= 100 && (data.replies.size() == 0 || data.replies[0] is map)
        && data.isPublic == true
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidCommunityMessage(data) {
      return data.keys().hasAll(['id', 'roomId', 'senderId', 'senderName', 'senderRole', 'text', 'isPublic', 'createdAt'])
        && data.keys().hasOnly(['id', 'roomId', 'senderId', 'senderName', 'senderRole', 'senderLocation', 'text', 'isPublic', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.senderRole is string && data.senderRole.size() <= 80
        && (!('senderLocation' in data) || (data.senderLocation is string && data.senderLocation.size() <= 120))
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 2000
        && data.isPublic == true
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidCommunityMember(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'isPublic', 'joinedAt', 'lastActiveAt'])
        && data.keys().hasOnly(['id', 'name', 'role', 'specialty', 'location', 'bio', 'topics', 'phoneNumber', 'email', 'deviceId', 'clientIp', 'isKycVerified', 'kycData', 'sellerPaymentMethods', 'completedInPersonDealsCount', 'providerLevel', 'disputeStrikes', 'hasProviderProtectionBadge', 'isAccountFrozen', 'isPublic', 'joinedAt', 'lastActiveAt'])
        && data.id == request.auth.uid
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.role is string && data.role.size() >= 1 && data.role.size() <= 80
        && (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 120))
        && (!('location' in data) || (data.location is string && data.location.size() <= 120))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 600))
        && (!('topics' in data) || (data.topics is list && data.topics.size() <= 10 && (data.topics.size() == 0 || data.topics[0] is string)))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30))
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 128))
        && (!('clientIp' in data) || (data.clientIp is string && data.clientIp.size() <= 64))
        && (!('isKycVerified' in data) || data.isKycVerified is bool)
        && (!('kycData' in data) || data.kycData is map)
        && (!('sellerPaymentMethods' in data) || (data.sellerPaymentMethods is list && data.sellerPaymentMethods.size() <= 5))
        && (!('completedInPersonDealsCount' in data) || data.completedInPersonDealsCount is number)
        && (!('providerLevel' in data) || data.providerLevel is number)
        && (!('disputeStrikes' in data) || data.disputeStrikes is number)
        && (!('hasProviderProtectionBadge' in data) || data.hasProviderProtectionBadge is bool)
        && (!('isAccountFrozen' in data) || data.isAccountFrozen is bool)
        && data.isPublic == true
        && data.joinedAt is string && data.joinedAt.size() <= 64
        && data.lastActiveAt is string && data.lastActiveAt.size() <= 64;
    }

    function isValidMarketplaceProvider(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'title', 'category', 'isPublic', 'registeredAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'title', 'category', 'listingKind', 'offerMode', 'condition', 'itemStatus', 'claimedById', 'claimedByName', 'claimedAt', 'experienceYears', 'rateInfo', 'location', 'bio', 'availability', 'services', 'isPublic', 'registeredAt'])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && (!('listingKind' in data) || data.listingKind in ['service', 'goods'])
        && (!('offerMode' in data) || data.offerMode in ['paid', 'gift'])
        && (!('condition' in data) || (data.condition is string && data.condition.size() <= 40))
        && (!('itemStatus' in data) || data.itemStatus in ['Available', 'Claimed'])
        && (!('claimedById' in data) || isValidId(data.claimedById))
        && (!('claimedByName' in data) || (data.claimedByName is string && data.claimedByName.size() >= 1 && data.claimedByName.size() <= 80))
        && (!('claimedAt' in data) || (data.claimedAt is string && data.claimedAt.size() <= 64))
        && (!('experienceYears' in data) || (data.experienceYears is number && data.experienceYears >= 0 && data.experienceYears <= 80))
        && (!('rateInfo' in data) || (data.rateInfo is string && data.rateInfo.size() <= 100))
        && (!('location' in data) || (data.location is string && data.location.size() <= 120))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 800))
        && (!('availability' in data) || (data.availability is string && data.availability.size() <= 100))
        && (!('services' in data) || (data.services is list && data.services.size() <= 15 && (data.services.size() == 0 || data.services[0] is string)))
        && data.isPublic == true
        && data.registeredAt is string && data.registeredAt.size() <= 64;
    }

    function isValidMarketplaceRequest(data) {
      return data.keys().hasAll(['id', 'ownerId', 'familyName', 'category', 'title', 'description', 'isPublic', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'familyName', 'category', 'needKind', 'acceptsGift', 'fulfillmentStatus', 'giftedById', 'giftedByName', 'giftNote', 'giftedAt', 'title', 'description', 'schedule', 'location', 'budget', 'isPublic', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.familyName is string && data.familyName.size() >= 1 && data.familyName.size() <= 80
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && (!('needKind' in data) || data.needKind in ['service', 'goods'])
        && (!('acceptsGift' in data) || data.acceptsGift is bool)
        && (!('fulfillmentStatus' in data) || data.fulfillmentStatus in ['Open', 'Gifted', 'Fulfilled'])
        && (!('giftedById' in data) || isValidId(data.giftedById))
        && (!('giftedByName' in data) || (data.giftedByName is string && data.giftedByName.size() >= 1 && data.giftedByName.size() <= 80))
        && (!('giftNote' in data) || (data.giftNote is string && data.giftNote.size() <= 500))
        && (!('giftedAt' in data) || (data.giftedAt is string && data.giftedAt.size() <= 64))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 1000
        && (!('schedule' in data) || (data.schedule is string && data.schedule.size() <= 100))
        && (!('location' in data) || (data.location is string && data.location.size() <= 120))
        && (!('budget' in data) || (data.budget is string && data.budget.size() <= 100))
        && data.isPublic == true
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidMarketplaceGift(data) {
      return data.keys().hasAll(['id', 'giftSourceType', 'targetListingId', 'itemKind', 'category', 'title', 'description', 'giverId', 'giverName', 'recipientId', 'recipientName', 'status', 'isPublic', 'createdAt'])
        && data.keys().hasOnly(['id', 'giftSourceType', 'targetListingId', 'itemKind', 'category', 'title', 'description', 'giverId', 'giverName', 'recipientId', 'recipientName', 'status', 'isPublic', 'createdAt'])
        && isValidId(data.id)
        && data.giftSourceType in ['need_fulfillment', 'gift_provision']
        && isValidId(data.targetListingId)
        && data.itemKind in ['service', 'goods']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 600
        && isValidId(data.giverId)
        && data.giverName is string && data.giverName.size() >= 1 && data.giverName.size() <= 80
        && isValidId(data.recipientId)
        && data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 80
        && data.status in ['Offered', 'Claimed', 'Received']
        && data.isPublic == true
        && data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64;
    }

    function isValidMarketplaceOrder(data) {
      return data.keys().hasAll(['id', 'orderCode', 'listingId', 'itemTitle', 'agreedAmount', 'currency', 'status', 'sellerId', 'sellerName', 'buyerId', 'buyerName', 'lockedPaymentMethod', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orderCode', 'listingId', 'itemTitle', 'category', 'itemKind', 'handoverType', 'agreedAmount', 'currency', 'isInternational', 'status', 'sellerId', 'sellerName', 'sellerPhone', 'sellerEmail', 'sellerDeviceId', 'sellerKycVerified', 'sellerProviderLevel', 'buyerId', 'buyerName', 'buyerPhone', 'buyerEmail', 'buyerDeviceId', 'buyerKycVerified', 'lockedPaymentMethod', 'paymentProof', 'reviewDeadline', 'sellerSuspended', 'confirmedAt', 'deniedAt', 'denialReason', 'denialStatementUrl', 'shippingProof', 'dispatchDeadline', 'shippedAt', 'deliveryEta', 'deliveryDisputedAt', 'deliveryDisputeEvidence', 'providerGraceDeadline', 'providerDeliveryResponse', 'courierDeliveredAt', 'autoCompleteDeadline', 'completedAt', 'isProviderFrozen', 'isConsumerStrikeApplied', 'providerProtectionAwarded', 'disputeNotes', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orderCode is string && data.orderCode.size() >= 3 && data.orderCode.size() <= 32
        && isValidId(data.listingId)
        && data.itemTitle is string && data.itemTitle.size() >= 1 && data.itemTitle.size() <= 150
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('itemKind' in data) || data.itemKind in ['service', 'goods'])
        && (!('handoverType' in data) || data.handoverType in ['in_person', 'shipping'])
        && data.agreedAmount is number && data.agreedAmount >= 0
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10
        && (!('isInternational' in data) || data.isInternational is bool)
        && data.status in ['locked', 'proof_submitted', 'confirmed', 'awaiting_dispatch', 'shipped', 'courier_delivered_pending_consumer_review', 'delivery_disputed', 'denied', 'completed', 'cancelled']
        && isValidId(data.sellerId)
        && data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 80
        && (!('sellerPhone' in data) || (data.sellerPhone is string && data.sellerPhone.size() <= 30))
        && (!('sellerEmail' in data) || (data.sellerEmail is string && data.sellerEmail.size() <= 100))
        && (!('sellerDeviceId' in data) || (data.sellerDeviceId is string && data.sellerDeviceId.size() <= 128))
        && (!('sellerKycVerified' in data) || data.sellerKycVerified is bool)
        && (!('sellerProviderLevel' in data) || data.sellerProviderLevel is number)
        && isValidId(data.buyerId)
        && data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 80
        && (!('buyerPhone' in data) || (data.buyerPhone is string && data.buyerPhone.size() <= 30))
        && (!('buyerEmail' in data) || (data.buyerEmail is string && data.buyerEmail.size() <= 100))
        && (!('buyerDeviceId' in data) || (data.buyerDeviceId is string && data.buyerDeviceId.size() <= 128))
        && (!('buyerKycVerified' in data) || data.buyerKycVerified is bool)
        && data.lockedPaymentMethod is map
        && (!('paymentProof' in data) || data.paymentProof is map)
        && (!('reviewDeadline' in data) || (data.reviewDeadline is string && data.reviewDeadline.size() <= 64))
        && (!('sellerSuspended' in data) || data.sellerSuspended is bool)
        && (!('confirmedAt' in data) || (data.confirmedAt is string && data.confirmedAt.size() <= 64))
        && (!('deniedAt' in data) || (data.deniedAt is string && data.deniedAt.size() <= 64))
        && (!('denialReason' in data) || (data.denialReason is string && data.denialReason.size() <= 500))
        && (!('denialStatementUrl' in data) || (data.denialStatementUrl is string && data.denialStatementUrl.size() <= 2048))
        && (!('shippingProof' in data) || data.shippingProof is map)
        && (!('dispatchDeadline' in data) || (data.dispatchDeadline is string && data.dispatchDeadline.size() <= 64))
        && (!('shippedAt' in data) || (data.shippedAt is string && data.shippedAt.size() <= 64))
        && (!('deliveryEta' in data) || (data.deliveryEta is string && data.deliveryEta.size() <= 64))
        && (!('deliveryDisputedAt' in data) || (data.deliveryDisputedAt is string && data.deliveryDisputedAt.size() <= 64))
        && (!('deliveryDisputeEvidence' in data) || data.deliveryDisputeEvidence is map)
        && (!('providerGraceDeadline' in data) || (data.providerGraceDeadline is string && data.providerGraceDeadline.size() <= 64))
        && (!('providerDeliveryResponse' in data) || data.providerDeliveryResponse is map)
        && (!('courierDeliveredAt' in data) || (data.courierDeliveredAt is string && data.courierDeliveredAt.size() <= 64))
        && (!('autoCompleteDeadline' in data) || (data.autoCompleteDeadline is string && data.autoCompleteDeadline.size() <= 64))
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 64))
        && (!('isProviderFrozen' in data) || data.isProviderFrozen is bool)
        && (!('isConsumerStrikeApplied' in data) || data.isConsumerStrikeApplied is bool)
        && (!('providerProtectionAwarded' in data) || data.providerProtectionAwarded is bool)
        && (!('disputeNotes' in data) || (data.disputeNotes is string && data.disputeNotes.size() <= 1000))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidMarketplaceBan(data) {
      return data.keys().hasAll(['id', 'targetUserId', 'targetDeviceId', 'reason', 'bannedAt', 'bannedBy'])
        && data.keys().hasOnly(['id', 'targetUserId', 'targetUserName', 'targetDeviceId', 'targetIp', 'reason', 'evidenceOrderId', 'bannedAt', 'bannedBy'])
        && isValidId(data.id)
        && isValidId(data.targetUserId)
        && (!('targetUserName' in data) || (data.targetUserName is string && data.targetUserName.size() <= 80))
        && data.targetDeviceId is string && data.targetDeviceId.size() >= 1 && data.targetDeviceId.size() <= 128
        && (!('targetIp' in data) || (data.targetIp is string && data.targetIp.size() <= 64))
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500
        && (!('evidenceOrderId' in data) || (data.evidenceOrderId is string && data.evidenceOrderId.size() <= 128))
        && data.bannedAt is string && data.bannedAt.size() <= 64
        && isValidId(data.bannedBy);
    }

    function isValidBabyName(data) {
      return data.keys().hasAll(['id', 'name', 'meaning', 'gender', 'origin', 'language', 'contributedBy', 'authorId', 'isPublic', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'meaning', 'significance', 'gender', 'origin', 'language', 'pronunciation', 'contributedBy', 'authorId', 'isPublic', 'createdAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.meaning is string && data.meaning.size() >= 1 && data.meaning.size() <= 500
        && (!('significance' in data) || (data.significance is string && data.significance.size() <= 1000))
        && data.gender in ['Male', 'Female', 'Unisex']
        && data.origin is string && data.origin.size() >= 1 && data.origin.size() <= 80
        && data.language is string && data.language.size() >= 1 && data.language.size() <= 80
        && (!('pronunciation' in data) || (data.pronunciation is string && data.pronunciation.size() <= 100))
        && data.contributedBy is string && data.contributedBy.size() >= 1 && data.contributedBy.size() <= 80
        && isValidId(data.authorId)
        && data.isPublic == true
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidCaregiverShift(data) {
      return data.keys().hasAll(['id', 'caregiverId', 'caregiverName', 'startTime', 'endTime', 'handedOverTo', 'createdAt'])
        && data.keys().hasOnly(['id', 'caregiverId', 'caregiverName', 'startTime', 'endTime', 'handedOverTo', 'notes', 'villageToken', 'villageOwnerId', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.caregiverId)
        && data.caregiverName is string && data.caregiverName.size() >= 1 && data.caregiverName.size() <= 80
        && data.startTime is string && data.startTime.size() >= 1 && data.startTime.size() <= 64
        && data.endTime is string && data.endTime.size() >= 1 && data.endTime.size() <= 64
        && data.handedOverTo is string && data.handedOverTo.size() >= 1 && data.handedOverTo.size() <= 120
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('villageToken' in data) || isValidId(data.villageToken))
        && (!('villageOwnerId' in data) || isValidId(data.villageOwnerId))
        && data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64;
    }

    // 4. Collection Rules

    // Private User Cloud Sync
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId) && isValidId(userId);
      allow create, update: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow delete: if isSignedIn() && isOwner(userId) && isValidId(userId);
    }

    // Cloud Multi-Device Sync ("Village Mode") — Token-gated, no list scraping
    match /villages/{villageToken} {
      allow get: if isSignedIn() && isValidId(villageToken);
      allow create: if isSignedIn() && isValidId(villageToken) && isValidVillageSync(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(villageToken) && isValidVillageSync(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().villageToken == existing().villageToken
        && incoming().diff(existing()).affectedKeys().hasOnly(['encryptedPayload', 'updatedAt', 'updatedBy', 'babyName']);
      allow delete: if isSignedIn() && isValidId(villageToken) && existing().ownerId == request.auth.uid;
    }

    // Baby Monitor WebRTC Signaling
    match /monitors/{villageToken} {
      allow get: if isSignedIn() && isValidId(villageToken);
      allow create, update: if isSignedIn() && isValidId(villageToken) && isValidMonitor(incoming());
      allow delete: if isSignedIn() && isValidId(villageToken);

      match /candidates/{candidateId} {
        allow create: if isSignedIn() && isValidId(candidateId) && isValidCandidate(incoming()) && exists(/databases/$(database)/documents/monitors/$(villageToken));
        allow list: if isSignedIn() && resource.data.from in ['viewer', 'camera'];
        allow delete: if isSignedIn() && isValidId(candidateId);
      }
    }

    // Community Forum Posts
    match /community_posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId) && existing().isPublic == true;
      allow list: if isSignedIn() && resource.data.isPublic == true;
      allow create: if isSignedIn() && isValidId(postId) && isValidCommunityPost(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().id == postId;
      allow update: if isSignedIn() && isValidId(postId) && isValidCommunityPost(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().id == existing().id
        && (
          (existing().authorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'tags', 'updatedAt'])) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['replies', 'upvotes', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(postId) && existing().authorId == request.auth.uid;
    }

    // Community Live Chat Messages
    match /community_messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && existing().isPublic == true;
      allow list: if isSignedIn() && resource.data.isPublic == true;
      allow create: if isSignedIn() && isValidId(messageId) && isValidCommunityMessage(incoming())
        && incoming().senderId == request.auth.uid
        && incoming().id == messageId;
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(messageId) && existing().senderId == request.auth.uid;
    }

    // Community Peer Network Members
    match /community_members/{memberId} {
      allow get: if isSignedIn() && isValidId(memberId) && existing().isPublic == true;
      allow list: if isSignedIn() && resource.data.isPublic == true;
      allow create: if isSignedIn() && isOwner(memberId) && isValidId(memberId) && isValidCommunityMember(incoming());
      allow update: if isSignedIn() && isOwner(memberId) && isValidId(memberId) && isValidCommunityMember(incoming())
        && incoming().id == existing().id
        && incoming().joinedAt == existing().joinedAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'specialty', 'location', 'bio', 'topics', 'phoneNumber', 'email', 'deviceId', 'clientIp', 'isKycVerified', 'kycData', 'sellerPaymentMethods', 'completedInPersonDealsCount', 'providerLevel', 'disputeStrikes', 'hasProviderProtectionBadge', 'isAccountFrozen', 'lastActiveAt']);
      allow delete: if isSignedIn() && isOwner(memberId) && isValidId(memberId);
    }

    // Marketplace Service Providers, Goods for Sale & Free Gift Provisions
    match /marketplace_providers/{providerId} {
      allow get: if isSignedIn() && isValidId(providerId) && existing().isPublic == true;
      allow list: if isSignedIn() && resource.data.isPublic == true;
      allow create: if isSignedIn() && isValidId(providerId) && isValidMarketplaceProvider(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().id == providerId;
      allow update: if isSignedIn() && isValidId(providerId) && isValidMarketplaceProvider(incoming())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().registeredAt == existing().registeredAt
        && (
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'title', 'category', 'listingKind', 'offerMode', 'condition', 'itemStatus', 'experienceYears', 'rateInfo', 'location', 'bio', 'availability', 'services'])) ||
          (existing().offerMode == 'gift'
            && (!('itemStatus' in existing()) || existing().itemStatus == 'Available')
            && incoming().itemStatus == 'Claimed'
            && incoming().claimedById == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['itemStatus', 'claimedById', 'claimedByName', 'claimedAt']))
        );
      allow delete: if isSignedIn() && isValidId(providerId) && existing().ownerId == request.auth.uid;
    }

    // Marketplace Goods & Care Needs
    match /marketplace_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && existing().isPublic == true;
      allow list: if isSignedIn() && resource.data.isPublic == true;
      allow create: if isSignedIn() && isValidId(requestId) && isValidMarketplaceRequest(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().id == requestId;
      allow update: if isSignedIn() && isValidId(requestId) && isValidMarketplaceRequest(incoming())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && (
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['familyName', 'category', 'needKind', 'acceptsGift', 'fulfillmentStatus', 'title', 'description', 'schedule', 'location', 'budget'])) ||
          ((!('fulfillmentStatus' in existing()) || existing().fulfillmentStatus == 'Open')
            && incoming().fulfillmentStatus == 'Gifted'
            && incoming().giftedById == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['fulfillmentStatus', 'giftedById', 'giftedByName', 'giftNote', 'giftedAt']))
        );
      allow delete: if isSignedIn() && isValidId(requestId) && existing().ownerId == request.auth.uid;
    }

    // Marketplace Free Gifts Exchange
    match /marketplace_gifts/{giftId} {
      allow get: if isSignedIn() && isValidId(giftId) && existing().isPublic == true;
      allow list: if isSignedIn() && resource.data.isPublic == true;
      allow create: if isSignedIn() && isValidId(giftId) && isValidMarketplaceGift(incoming())
        && incoming().id == giftId
        && (
          (incoming().giftSourceType == 'need_fulfillment' && incoming().giverId == request.auth.uid && incoming().status == 'Offered') ||
          (incoming().giftSourceType == 'gift_provision' && incoming().recipientId == request.auth.uid && incoming().status == 'Claimed')
        );
      allow update: if isSignedIn() && isValidId(giftId) && isValidMarketplaceGift(incoming())
        && incoming().id == existing().id
        && incoming().giverId == existing().giverId
        && incoming().recipientId == existing().recipientId
        && incoming().createdAt == existing().createdAt
        && (existing().giverId == request.auth.uid || existing().recipientId == request.auth.uid)
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'description']);
      allow delete: if isSignedIn() && isValidId(giftId) && (existing().giverId == request.auth.uid || existing().recipientId == request.auth.uid);
    }

    // Marketplace Locked Orders & External Verification
    match /marketplace_orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId)
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(orderId) && isValidMarketplaceOrder(incoming())
        && incoming().buyerId == request.auth.uid
        && incoming().id == orderId;
      allow update: if isSignedIn() && isValidId(orderId) && isValidMarketplaceOrder(incoming())
        && incoming().id == existing().id
        && incoming().orderCode == existing().orderCode
        && incoming().listingId == existing().listingId
        && incoming().sellerId == existing().sellerId
        && incoming().buyerId == existing().buyerId
        && incoming().createdAt == existing().createdAt
        && (
          (existing().buyerId == request.auth.uid && incoming().status == 'proof_submitted'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentProof', 'reviewDeadline', 'updatedAt'])) ||
          (existing().sellerId == request.auth.uid && (incoming().status == 'confirmed' || incoming().status == 'awaiting_dispatch')
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'confirmedAt', 'dispatchDeadline', 'updatedAt'])) ||
          (existing().sellerId == request.auth.uid && incoming().status == 'shipped'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'shippingProof', 'shippedAt', 'deliveryEta', 'updatedAt'])) ||
          (existing().buyerId == request.auth.uid && incoming().status == 'delivery_disputed'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deliveryDisputedAt', 'deliveryDisputeEvidence', 'providerGraceDeadline', 'disputeNotes', 'updatedAt'])) ||
          (existing().sellerId == request.auth.uid && incoming().status == 'courier_delivered_pending_consumer_review'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'providerDeliveryResponse', 'courierDeliveredAt', 'autoCompleteDeadline', 'disputeNotes', 'updatedAt'])) ||
          ((existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid) && incoming().status == 'completed'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])) ||
          (existing().sellerId == request.auth.uid && incoming().status == 'denied'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deniedAt', 'denialReason', 'denialStatementUrl', 'updatedAt'])) ||
          ((existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'disputeNotes', 'sellerSuspended', 'isProviderFrozen', 'isConsumerStrikeApplied', 'providerProtectionAwarded', 'updatedAt']))
        );
      allow delete: if false;
    }

    // Marketplace Fraud Bans
    match /marketplace_bans/{banId} {
      allow get: if isSignedIn() && isValidId(banId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(banId) && isValidMarketplaceBan(incoming())
        && incoming().id == banId
        && incoming().bannedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Global Baby Name Database
    match /baby_names/{nameId} {
      allow get: if isValidId(nameId) && existing().isPublic == true;
      allow list: if resource.data.isPublic == true;
      allow create: if isSignedIn() && isValidId(nameId) && isValidBabyName(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().id == nameId;
      allow update: if isSignedIn() && isValidId(nameId) && isValidBabyName(incoming())
        && existing().authorId == request.auth.uid
        && incoming().authorId == existing().authorId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['meaning', 'significance', 'pronunciation', 'origin', 'language', 'contributedBy']);
      allow delete: if isSignedIn() && isValidId(nameId) && existing().authorId == request.auth.uid;
    }

    // Caregiver & Nanny Shift & Handover Records
    match /caregiver_shifts/{shiftId} {
      allow get: if isSignedIn() && isValidId(shiftId)
        && (existing().caregiverId == request.auth.uid || existing().villageOwnerId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.caregiverId == request.auth.uid || resource.data.villageOwnerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(shiftId) && isValidCaregiverShift(incoming())
        && incoming().caregiverId == request.auth.uid
        && incoming().id == shiftId;
      allow update: if isSignedIn() && isValidId(shiftId) && isValidCaregiverShift(incoming())
        && existing().caregiverId == request.auth.uid
        && incoming().caregiverId == existing().caregiverId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['startTime', 'endTime', 'handedOverTo', 'notes', 'caregiverName']);
      allow delete: if isSignedIn() && isValidId(shiftId) && existing().caregiverId == request.auth.uid;
    }
  }
}
