rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net - deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Helper functions for access control
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. User Data Rules: Hardened HIPAA/COPPA-compliant Document Rules
    // Enforces that users can only manage their own documents, validates owner ID,
    // and strictly limits schema keys to encrypted database payloads for maximum privacy.
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasAll(['userId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['userId', 'encryptedPayload', 'updatedAt']);
        
      allow delete: if isOwner(userId);
    }
  }
}
