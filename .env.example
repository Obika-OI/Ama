# GEMINI_API_KEY: Required for Gemini AI API calls.
# Injected at runtime or set in your environment configuration.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# Injected at runtime or set to your custom hostname.
# Used for self-referential links, partner invitations, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Used for Paystack subscriptions and checkout.
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."
